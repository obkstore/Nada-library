# --- Database ---
# Dev (Docker): mongodb://localhost:27017/toyshop
# Prod (Atlas M0): mongodb+srv://<user>:<pass>@<cluster>/toyshop
MONGODB_URI=mongodb://localhost:27017/toyshop
NODE_ENV=development
PORT=5000

# --- Auth (admin JWT) ---
# REQUIRED in production: min 32 chars. Server fails fast at startup if missing/weak when NODE_ENV=production.
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=8h

# --- CORS ---
# Comma-separated allowed origins for the Vite dev server and prod domain
CLIENT_URL=http://localhost:5173

# --- Cloudinary (optional in dev, REQUIRED in production) ---
# If empty + NODE_ENV!=production -> local disk fallback (server/uploads) with a startup warning.
# If empty + NODE_ENV=production -> server refuses to start.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Seed admin (used by npm run seed; seed REFUSES to run when NODE_ENV=production) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
